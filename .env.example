# Copy this file to ".env" and edit. Every value is optional.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SQLite file (created automatically). Use an absolute path on a persistent disk in production.
DB_FILE=data/karnataka.db

# Comma separated emails that become admins (can open /admin.html). They must sign up first.
ADMIN_EMAILS=

# Set to true when the site is served over HTTPS (cookies get the Secure flag + HSTS header).
COOKIE_SECURE=false
# Set to true only when running behind a reverse proxy (nginx, Render, Railway, Fly...) so the
# real visitor IP is read from X-Forwarded-For. Leave false if the server is exposed directly.
TRUST_PROXY=false

# Password reset: in development the 6-digit code is returned in the API response so the demo UI
# can show it. In production set this to false and configure e-mail below.
RESET_CODE_IN_RESPONSE=true

# Optional e-mail delivery through https://resend.com (password reset codes, contact notifications)
RESEND_API_KEY=
MAIL_FROM=Karnataka Tour <no-reply@yourdomain.com>
# Where new contact-form messages are e-mailed (optional)
CONTACT_NOTIFY_EMAIL=
